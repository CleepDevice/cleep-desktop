{
    "name": "cleep-desktop",
    "version": "1.0.0",
    "description": "Desktop application to manage your Cleep devices",
    "main": "main.js",
    "scripts": {
        "copyfiles": "copyfiles \"html/**/*\" build/ && copyfiles \"core/**/*\" build/ && copyfiles cleepdesktopcore.py build/ && copyfiles dev-app-update.yml build/ && copyfiles package.json build/ && copyfiles \"resources/flashtool/**/*\" build/resources/",
        "copy:elevate-exe": "copyfiles --flat \"src/sudo/elevate.exe\" \"build/sudo/\"",
        "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=build/preload.js",
        "build:sentry-renderer": "esbuild src/sentry-renderer.ts --bundle --platform=browser --format=iife --global-name=CleepSentry --outfile=html/js/libs/sentry-renderer.js",
        "build": "rimraf build && tsc && npm run build:preload && npm run build:sentry-renderer && npm run copy:elevate-exe && npm run copyfiles",
        "package:rpi-imager": "scripts/package-rpi-imager.sh",
        "start": "npm run build && electron ./build/main.js",
        "start:dev": "npm run build && concurrently -k -n tsc,preload,sentry,electron -c blue,magenta,cyan,green \"tsc -w --preserveWatchOutput\" \"npm run build:preload -- --watch\" \"npm run build:sentry-renderer -- --watch\" \"node scripts/electron-dev.js\"",
        "lint": "oxlint ./src",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "npm run build && playwright test",
        "test:e2e:raw": "playwright test",
        "build-linux": "scripts/build-linux.sh",
        "build-macos": "scripts/build-mac.sh",
        "build-win": "scripts\\build-windows.bat",
        "publish-linux": "scripts/build-linux.sh publish",
        "publish-macos": "scripts/build-mac.sh publish",
        "publish-win": "scripts\\build-windows.bat publish"
    },
    "repository": "https://github.com/CleepDevice/cleep-desktop",
    "keywords": [
        "cleep",
        "rasperrypi",
        "automation",
        "iot"
    ],
    "author": "Tanguy BONNEAU <tanguy.bonneau@gmail.com>",
    "license": "MIT",
    "devDependencies": {
        "@electron/notarize": "^3.1.2",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "@types/node-wifi": "^2.0.2",
        "@types/unzipper": "^0.10.11",
        "@vitest/coverage-v8": "^5.0.5",
        "chokidar": "^6.0.0",
        "concurrently": "^10.0.6",
        "copyfiles": "^2.4.1",
        "electron": "45.2.1",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "oxlint": "^1.90.0",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@sentry/electron": "^8.3.0",
        "axios": "^1.21.0",
        "detect-port": "^2.1.0",
        "drivelist": "^12.0.2",
        "electron-log": "^5.4.4",
        "electron-settings": "^4.0.4",
        "electron-updater": "^6.8.11",
        "mime": "^4.1.2",
        "node-wifi": "^2.0.16",
        "unzipper": "^0.12.5",
        "uuid": "^14.0.3",
        "zod": "^4.6.7"
    },
    "build": {
        "appId": "com.cleep.cleepdesktop",
        "productName": "CleepDesktop",
        "electronVersion": "45.2.1",
        "asar": true,
        "linux": {
            "icon": "resources/",
            "target": [
                "AppImage"
            ],
            "maintainer": "Tanguy Bonneau <tanguy.bonneau@gmail.com>",
            "category": "Utility",
            "executableName": "cleepdesktop",
            "synopsis": "Cleep desktop application",
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
        },
        "deb": {
            "icon": "resources/256x256.png",
            "packageCategory": "misc",
            "priority": "optional",
            "depends": []
        },
        "win": {
            "icon": "resources/icon",
            "target": "nsis",
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "verifyUpdateCodeSignature": false
        },
        "nsis": {
            "menuCategory": "Cleep",
            "shortcutName": "CleepDesktop"
        },
        "mac": {
            "category": "public.app-category.utilities",
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "resources/icon",
            "extendInfo": "config/Info.plist",
            "binaries": [],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "hardenedRuntime": true,
            "entitlements": "config/entitlements.mac.plist",
            "entitlementsInherit": "config/entitlements.mac.plist",
            "gatekeeperAssess": false,
            "minimumSystemVersion": "12.0.0"
        },
        "dmg": {
            "icon": "resources/icon.icns",
            "sign": false
        },
        "publish": {
            "provider": "github",
            "owner": "CleepDevice",
            "releaseType": "prerelease",
            "repo": "cleep-desktop"
        },
        "extraResources": [
            {
                "from": "resources/flashtool",
                "to": "flashtool",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "allowScripts": {
        "electron@45.2.1": true,
        "drivelist@12.0.2": true,
        "esbuild@0.28.2": true,
        "electron-winstaller@5.4.0": true
    }
}
