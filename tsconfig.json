{
    "compilerOptions": {
        "module": "CommonJS",
        "noImplicitAny": true,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "build",
        "target": "ES2023",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "src/"
    ],
    "exclude": [
        "src/preload.ts"
    ]
}